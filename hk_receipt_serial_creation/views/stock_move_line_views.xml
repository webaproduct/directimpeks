<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add serial_number field to detailed operations tree view -->
    <record id="simbioz_stock_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.tree.simbioz.imp</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="serial_number" />
            </xpath>
        </field>
    </record>
</odoo>
