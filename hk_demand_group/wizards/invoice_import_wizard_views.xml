<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for invoice import lines -->
    <record id="view_wizard_invoice_import_tree" model="ir.ui.view">
        <field name="name">wizard.invoice.import.line.tree</field>
        <field name="model">wizard.invoice.import.line</field>
        <field name="arch" type="xml">
            <tree string="Invoice Lines" decoration-danger="not product_id">
                <field name="sequence"/>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="base_price"/>
                <field name="discount"/>
                <field name="price_with_discount"/>
                <field name="recipient_code"/>
                <field name="recipient_partner_id"/>
                <field name="invoice_number"/>
                <field name="primary_order_number"/>
                <field name="source_purchase_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view for invoice import lines -->
    <record id="view_wizard_invoice_import_form" model="ir.ui.view">
        <field name="name">wizard.invoice.import.line.form</field>
        <field name="model">wizard.invoice.import.line</field>
        <field name="arch" type="xml">
            <form string="Invoice Line">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="barcode"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="base_price"/>
                            <field name="discount"/>
                            <field name="price_with_discount"/>
                        </group>
                        <group>
                            <field name="recipient_code"/>
                            <field name="recipient_partner_id"/>
                            <field name="invoice_number"/>
                            <field name="primary_order_number"/>
                            <field name="source_purchase_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Розподіл" name="distribution_lines">
                            <field name="distribution_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="quantity_purchase"/>
<!--                                    <field name="quantity_result"/>-->
                                    <field name="recipient_partner_id"/>
                                    <field name="source_purchase_id"/>
                                    <field name="source_purchase_line_id"/>
                                    <field name="demand_group_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form view for invoice import wizard -->
    <!-- Tree view for distribution lines -->
    <record id="view_wizard_invoice_import_distribution_tree" model="ir.ui.view">
        <field name="name">wizard.invoice.import.distribution.tree</field>
        <field name="model">wizard.invoice.import.distribution</field>
        <field name="arch" type="xml">
            <tree string="Distribution Lines" editable="bottom">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="quantity_purchase"/>
<!--                <field name="quantity_result"/>-->
                <field name="recipient_partner_id"/>
                <field name="source_purchase_id"/>
                <field name="source_purchase_line_id"/>
                <field name="demand_group_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view for distribution lines -->
    <record id="view_wizard_invoice_import_distribution_form" model="ir.ui.view">
        <field name="name">wizard.invoice.import.distribution.form</field>
        <field name="model">wizard.invoice.import.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribution Line">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="quantity_purchase"/>
<!--                            <field name="quantity_result"/>-->
                        </group>
                        <group>
                            <field name="recipient_partner_id"/>
                            <field name="source_purchase_id"/>
                            <field name="source_purchase_line_id"/>
                            <field name="demand_group_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for purchase lines -->
    <record id="view_wizard_invoice_import_purchase_tree" model="ir.ui.view">
        <field name="name">wizard.invoice.import.purchase.tree</field>
        <field name="model">wizard.invoice.import.purchase</field>
        <field name="arch" type="xml">
            <tree string="Purchase Lines">
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="product_id"/>
                <field name="demand_group_id"/>
                <field name="recipient_partner_id"/>
                <field name="quantity_plan"/>
                <field name="quantity_distributed"/>
            </tree>
        </field>
    </record>

    <!-- Form view for invoice import wizard -->
    <record id="view_invoice_import_wizard_form" model="ir.ui.view">
        <field name="name">wizard.invoice.import.settings.form</field>
        <field name="model">wizard.invoice.import.settings</field>
        <field name="arch" type="xml">
            <form string="Import Invoice">
                <sheet>
                    <group>
                        <group>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="internal_owner_id"/>
                            <field name="picking_type_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="selected_line_id" domain="[('wizard_id', '=', id)]" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <notebook>
                        <page string="Інвойс" name="invoice_lines">
                            <field name="invoice_line_ids">
                                <tree decoration-danger="not product_id" create="false" edit="false" delete="false">
                                    <field name="sequence"/>
                                    <field name="barcode"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="base_price"/>
                                    <field name="discount"/>
                                    <field name="price_with_discount"/>
                                    <field name="recipient_code"/>
                                    <field name="recipient_partner_id"/>
                                    <field name="invoice_number"/>
                                    <field name="primary_order_number"/>
                                    <field name="source_purchase_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Розподіл" name="distribution_lines">
                            <field name="distribution_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="quantity_purchase"/>
<!--                                    <field name="quantity_result"/>-->
                                    <field name="recipient_partner_id"/>
                                    <field name="source_purchase_id"/>
                                    <field name="source_purchase_line_id"/>
                                    <field name="demand_group_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Замовлення" name="purchase_lines">
                            <field name="purchase_line_ids">
                                <tree>
                                    <field name="partner_id"/>
                                    <field name="purchase_id"/>
                                    <field name="product_id"/>
                                    <field name="demand_group_id"/>
                                    <field name="recipient_partner_id"/>
                                    <field name="quantity_plan"/>
                                    <field name="quantity_distributed"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_import_file" string="Завантажити" type="object" class="btn-primary"/>
                    <button name="action_distribute" string="Розподілити" type="object" class="btn-primary"/>
                    <button name="action_save" string="Записати" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Відмінити" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard action -->
    <record id="action_invoice_import_wizard" model="ir.actions.act_window">
        <field name="name">Завантажити фактуру</field>
        <field name="res_model">wizard.invoice.import.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item in Purchase section -->
    <menuitem id="menu_invoice_import_wizard"
              name="Завантажити фактуру"
              parent="purchase.menu_procurement_management"
              action="action_invoice_import_wizard"
              sequence="100"/>
</odoo>
