<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add date_planned field to product.template form in Purchase tab -->
    <record id="product_template_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hk.demand.group</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']//group[@name='purchase']" position="inside">
                <field name="date_planned"/>
            </xpath>
        </field>
    </record>
</odoo>
