<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form for demand.group -->
    <record id="view_demand_group_form" model="ir.ui.view">
        <field name="name">demand.group.form</field>
        <field name="model">demand.group</field>
        <field name="arch" type="xml">
            <form string="Order Group">
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Group Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="stock_request_id"/>
                            <field name="active" invisible="True"/>
                        </group>
                    </group>
            </form>
        </field>
    </record>

    <!-- Tree for demand.group -->
    <record id="view_demand_group_tree" model="ir.ui.view">
        <field name="name">demand.group.tree</field>
        <field name="model">demand.group</field>
        <field name="arch" type="xml">
            <tree string="Order Groups">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="stock_request_id"/>
            </tree>
        </field>
    </record>

    <!-- Search for demand.group -->
    <record id="view_demand_group_search" model="ir.ui.view">
        <field name="name">demand.group.search</field>
        <field name="model">demand.group</field>
        <field name="arch" type="xml">
            <search string="Search Order Groups">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="stock_request_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group by">
                    <filter string="Sales Order" name="sale_order" context="{'group_by': 'sale_order_id'}"/>
                    <filter string="Stock Request" name="stock_request" context="{'group_by': 'stock_request_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for demand.group -->
    <record id="action_demand_group" model="ir.actions.act_window">
        <field name="name">Order Groups</field>
        <field name="res_model">demand.group</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_demand_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first order group
            </p>
            <p>
                Order groups allow aggregating order lines related to sales orders or stock requests.
            </p>
        </field>
    </record>

    <!-- Menu item for demand.group -->
    <menuitem id="menu_demand_group"
              name="Order Groups"
              action="action_demand_group"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="20"/>
</odoo>
