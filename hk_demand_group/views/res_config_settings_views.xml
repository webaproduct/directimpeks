<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings view extension -->
    <record id="res_config_settings_view_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hk.demand.group</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add new fields to the "Default Accounts" section -->
            <xpath expr="//block[@id='default_accounts']" position="inside">
                <setting string="Intercompany Settlements">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="intercompany_account_id" class="col-lg-5 o_light_label"/>
                            <field name="intercompany_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="intercompany_price_list_id" class="col-lg-5 o_light_label"/>
                            <field name="intercompany_price_list_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
