<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Додаємо поля до форми рядка замовлення на купівлю -->
    <record id="purchase_order_line_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.line.form.inherit.hk.demand.group</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//form//group" position="inside">
                <group string="Група отримання">
                    <field name="demand_group_id"/>
                    <field name="demand_partner_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Додаємо поля до форми замовлення на купівлю для відображення в рядках -->
    <record id="purchase_order_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.hk.demand.group</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Додаємо поле internal_owner_id до форми замовлення -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="internal_owner_id"/>
            </xpath>
            
            <!-- Додаємо поля до рядків замовлення -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="demand_partner_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
