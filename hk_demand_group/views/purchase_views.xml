<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for related purchase order lines -->
    <record id="purchase_order_line_tree_related" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.related</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree string="Related Purchase Order Lines" create="false" edit="false">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_qty"/>
                <field name="product_uom"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="price_subtotal"/>
                <field name="demand_group_id"/>
                <field name="source_purchase_order_id"/>
                <field name="source_purchase_order_line_id"/>
            </tree>
        </field>
    </record>

    <!-- Add fields to purchase order line form -->
    <record id="purchase_order_line_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.line.form.inherit.hk.demand.group</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//form//group" position="inside">
                <group string="Receiving Group">
                    <field name="demand_group_id"/>
                    <field name="demand_partner_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add fields to purchase order form for displaying in lines -->
    <record id="purchase_order_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.hk.demand.group</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add smart button for related purchases -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_source_purchases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-arrow-left"
                        invisible="source_purchase_count == 0">
                    <field name="source_purchase_count" widget="statinfo" string="Первинні замовлення"/>
                </button>
                <button name="action_view_related_purchases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="related_purchase_count == 0">
                    <field name="related_purchase_count" widget="statinfo" string="Related Orders"/>
                </button>
                <button name="action_view_related_purchase_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="related_purchase_line_count == 0">
                    <field name="related_purchase_line_count" widget="statinfo" string="Related Lines"/>
                </button>
            </xpath>
            
            <!-- Add internal_owner_id to order form -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="internal_owner_id"/>
            </xpath>
            
            <!-- Add fields to order lines -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="after">
                <field name="delivery_date" optional="show"/>
                <field name="demand_group_id" optional="show"/>
                <field name="demand_partner_id" optional="hide"/>
                <field name="source_purchase_order_id" optional="hide"/>
                <field name="source_purchase_order_line_id" optional="hide"/>
            </xpath>
            
            <!-- Add additional_purchase field after date_planned -->
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <field name="additional_purchase"/>
            </xpath>
            
            <!-- Add fact_purchase field to Other Information tab -->
            <xpath expr="//page[@name='purchase_delivery_invoice']//group[@name='other_info']" position="inside">
                <field name="fact_purchase" readonly="True"/>
            </xpath>
        </field>
    </record>

    <!-- Extend purchase_order_kpis_tree to add fact_purchase and additional_purchase fields -->
    <record id="purchase_order_kpis_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.hk.demand.group</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="fact_purchase" optional="hide"/>
                <field name="additional_purchase" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend view_purchase_order_filter to add filters and grouping for fact_purchase and additional_purchase -->
    <record id="view_purchase_order_filter_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">purchase.order.filter.inherit.hk.demand.group</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <!-- Add filters -->
            <xpath expr="//filter[@name='late_rfqs']" position="after">
                <separator/>
                <filter name="fact_purchase" string="Фактична закупівля" domain="[('fact_purchase', '=', True)]"/>
                <filter name="additional_purchase" string="Дозамовлення" domain="[('additional_purchase', '=', True)]"/>
            </xpath>
            
            <!-- Add grouping -->
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="Фактична закупівля" name="group_fact_purchase" domain="[]" context="{'group_by': 'fact_purchase'}"/>
                <filter string="Дозамовлення" name="group_additional_purchase" domain="[]" context="{'group_by': 'additional_purchase'}"/>
            </xpath>
        </field>
    </record>

    <!-- Tree view for purchase order line analysis -->
    <record id="purchase_order_line_analysis_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.analysis.tree</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree string="Аналіз надходження товарів" create="false" edit="false">
                <field name="order_id"/>
                <field name="partner_id" string="Постачальник"/>
                <field name="partner_ref"/>
                <field name="product_id"/>
                <field name="demand_group_id"/>
                <field name="demand_partner_id"/>
                <field name="delivery_date" optional="show"/>
                <field name="product_qty" sum="Замовлена кількість"/>
                <field name="price_total" sum="Вартість замовленого товару"/>
                <field name="qty_received" sum="Отримана кількість"/>
                <field name="amount_received" sum="Вартість отриманого товару"/>
                <field name="remain_qty" sum="Залишилось отримати кількість"/>
                <field name="remain_amount" sum="Залишилось отримати Вартість"/>
                <field name="brand_id" optional="show"/>
                <field name="number_line" optional="show"/>
                <field name="season_base" optional="show"/>
                <field name="category_one" optional="show"/>
                <field name="category_two" optional="show"/>
                <field name="form" optional="show"/>
                <field name="attribute_line_value_ids" widget="many2many_tags" optional="show"/>
                <field name="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Pivot view for purchase order line analysis -->
    <record id="purchase_order_line_analysis_pivot" model="ir.ui.view">
        <field name="name">purchase.order.line.analysis.pivot</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Аналіз надходження товарів">
                <field name="partner_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="product_qty" type="measure"/>
                <field name="price_total" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="amount_received" type="measure"/>
                <field name="remain_qty" type="measure"/>
                <field name="remain_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search view for purchase order line analysis -->
    <record id="purchase_order_line_analysis_search" model="ir.ui.view">
        <field name="name">purchase.order.line.analysis.search</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Пошук">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="partner_ref"/>
                <field name="product_id"/>
                <field name="demand_group_id"/>
                <field name="demand_partner_id"/>
                <separator/>
                <filter string="ЗНКП" name="filter_draft_sent" domain="[('order_id.state', 'in', ['draft', 'sent'])]"/>
                <separator/>
                <filter string="Дата доставки" name="delivery_date" date="delivery_date"/>
                <separator/>
                <group expand="0" string="Групувати за">
                    <filter string="Дата доставки" name="group_delivery_date" domain="[]" context="{'group_by': 'delivery_date'}"/>
                    <filter string="Валюта замовлення" name="group_currency" domain="[]" context="{'group_by': 'currency_id'}"/>
                    <filter string="Постачальник" name="group_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Референс постачальника" name="group_partner_ref" domain="[]" context="{'group_by': 'partner_ref'}"/>
                    <filter string="Отримувач" name="group_demand_partner" domain="[]" context="{'group_by': 'demand_partner_id'}"/>
                    <filter string="Замовлення (група попиту)" name="group_demand_group" domain="[]" context="{'group_by': 'demand_group_id'}"/>
                    <filter string="Бренд" name="group_brand" domain="[]" context="{'group_by': 'brand_id'}"/>
                    <filter string="№ лінії" name="group_number_line" domain="[]" context="{'group_by': 'number_line'}"/>
                    <filter string="Сезон/база" name="group_season_base" domain="[]" context="{'group_by': 'season_base'}"/>
                    <filter string="Категорія 1" name="group_category_one" domain="[]" context="{'group_by': 'category_one'}"/>
                    <filter string="Категорія 2" name="group_category_two" domain="[]" context="{'group_by': 'category_two'}"/>
                    <filter string="Форма" name="group_form" domain="[]" context="{'group_by': 'form'}"/>
<!--                    <filter string="Атрибути" name="group_attribute" domain="[]" context="{'group_by': 'attribute_line_ids'}"/>-->
                    <filter string="Значення атрибутів" name="group_attribute_value" domain="[]" context="{'group_by': 'attribute_line_value_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for purchase order line analysis -->
    <record id="action_purchase_order_line_analysis" model="ir.actions.act_window">
        <field name="name">Аналіз надходження товарів від постачальника</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">tree,pivot</field>
        <field name="view_id" ref="purchase_order_line_analysis_tree"/>
        <field name="search_view_id" ref="purchase_order_line_analysis_search"/>
        <field name="context">{'search_default_filter_draft_sent': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Немає даних для відображення
            </p>
            <p>
                Аналіз надходження товарів від постачальника дозволяє відстежувати замовлені та отримані товари.
            </p>
        </field>
    </record>

    <!-- Menu item in Purchase > Reporting -->
    <menuitem id="menu_purchase_order_line_analysis_purchase"
              name="Аналіз надходження товарів від постачальника"
              action="action_purchase_order_line_analysis"
              parent="purchase.purchase_report_main"
              sequence="100"/>

    <!-- Menu item in Sales > Reporting -->
    <menuitem id="menu_purchase_order_line_analysis_sale"
              name="Аналіз надходження товарів від постачальника"
              action="action_purchase_order_line_analysis"
              parent="sale.menu_sale_report"
              sequence="100"/>
</odoo>
