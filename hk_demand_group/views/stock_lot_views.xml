<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Додаємо поля до форми серійних/партійних номерів -->
    <record id="view_production_lot_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.hk.demand.group</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="internal_owner_id"/>
                <field name="purchase_order_id"/>
                <field name="demand_group_id"/>
            </xpath>
        </field>
    </record>

    <!-- Додаємо поля до дерева серійних/партійних номерів -->
    <record id="view_production_lot_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.hk.demand.group</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="internal_owner_id"/>
                <field name="purchase_order_id"/>
                <field name="demand_group_id"/>
            </xpath>
        </field>
    </record>
</odoo>
