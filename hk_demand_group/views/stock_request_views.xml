<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add field to stock request form -->
    <record id="view_stock_request_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.request.form.view.inherit.hk.demand.group</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="warehouse_stock_request_app.wh_stock_request_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="demand_group_id"/>
            </xpath>
            
            <xpath expr="//field[@name='approved_by']" position="after">
                <field name="for_purchase"/>
            </xpath>
            
            <!-- Update visibility and labels for buttons -->
            <xpath expr="//button[@name='action_create_picking']" position="attributes">
                <attribute name="invisible">states in ('draft','approve','receive','cancelled')</attribute>
                <attribute name="string">Approve</attribute>
            </xpath>
            
            <xpath expr="//button[@name='action_done']" position="attributes">
                <attribute name="invisible">states in ('draft','confirmed','receive','cancelled')</attribute>
            </xpath>
            
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">states in ('cancelled', 'receive')</attribute>
                <attribute name="string">Cancel</attribute>
                <attribute name="special"></attribute>
                <attribute name="class">btn-secondary</attribute>
            </xpath>
            
            <!-- Add Set to Draft button for cancelled status -->
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_draft" string="Set to Draft" 
                        type="object" class="btn-secondary"
                        invisible="states != 'cancelled'"/>
            </xpath>
            
            <!-- Add cancelled to statusbar -->
            <xpath expr="//field[@name='states']" position="attributes">
                <attribute name="statusbar_visible">draft,confirmed,approve,receive,cancelled</attribute>
            </xpath>
        </field>
    </record>
</odoo>
