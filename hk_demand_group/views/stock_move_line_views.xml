<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add fields to detailed move lines tree -->
    <record id="view_move_line_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to detailed operations tree in picking -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to  operations tree in picking -->
    <record id="view_stock_move_line_view_stock_move_line_operation_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to  operations tree in picking -->
    <record id="view_move_line_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>
    <!-- Add fields to  operations tree in picking -->
    <record id="view_move_line_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>


    <!-- Add fields to stock.move.line search -->
    <record id="stock_move_line_view_search_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.hk.demand.group</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="demand_group_id"/>
                <field name="buyer_id"/>
            </xpath>
            <xpath expr="//filter[@name='groupby_product_id']" position="after">
                <filter string="Demand Group" name="by_demand_group" context="{'group_by': 'demand_group_id'}"/>
                <filter string="Recipient" name="by_buyer" context="{'group_by': 'buyer_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
