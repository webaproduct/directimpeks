<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Додаємо поля до форми переміщення товарів -->
    <record id="view_move_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.hk.demand.group</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Додаємо поля в групу "Походження" -->
            <xpath expr="//group[@name='origin_grp']" position="inside">
                <field name="demand_group_id"/>
                <field name="buyer_id"/>
            </xpath>
        </field>
    </record>
</odoo>
