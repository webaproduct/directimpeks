<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add fields to stock.move form -->
    <record id="view_move_form_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.hk.demand.group</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add fields into the "Origin" group -->
            <xpath expr="//group[@name='origin_grp']" position="inside">
                <field name="demand_group_id"/>
                <field name="buyer_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to stock.move tree view -->
    <record id="view_move_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to picking move tree view -->
    <record id="view_picking_move_tree_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.picking.tree.inherit.hk.demand.group</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_picking_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="demand_group_id" optional="show"/>
                <field name="buyer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to stock.move search -->
    <record id="view_move_search_inherit_hk_demand_group" model="ir.ui.view">
        <field name="name">stock.move.search.inherit.hk.demand.group</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="demand_group_id"/>
                <field name="buyer_id"/>
            </xpath>
            <xpath expr="//filter[@name='groupby_dest_location_id']" position="after">
                <filter string="Demand Group" name="groupby_demand_group" context="{'group_by': 'demand_group_id'}"/>
                <filter string="Recipient" name="groupby_buyer" context="{'group_by': 'buyer_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
