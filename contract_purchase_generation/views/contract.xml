<odoo>
    <record id="contract_contract_form_view_recurring_purchase_form" model="ir.ui.view">
        <field name="name">contract.contract.form.recurring.purchase.form</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//button[@name='recurring_create_invoice']" position="before">
                <button
                    groups="base.group_no_one"
                    name="recurring_create_purchase"
                    string="Create Purchases"
                    type="object"
                />
            </xpath>
            <!-- invisible="contract_type != 'purchase'" -->
            <xpath expr="//button[@name='action_show_invoices']" position="after">
                <button
                    class="oe_stat_button"
                    icon="fa-list"
                    name="action_show_purchases"
                    type="object"
                >
                <!-- invisible="contract_type != 'purchase'" -->
                    <field
                        name="purchase_count"
                        string="Purchases Order"
                        widget="statinfo"
                    />
                </button>
            </xpath>

            <xpath expr="//button[@name='recurring_create_sale']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Create Sales</attribute>
                <!-- contract_type != 'sale' -->
            </xpath>
            <!-- <xpath expr="//button[@name='action_show_sales']" position="attributes">
                <attribute
                    name="invisible"
                >generation_type != 'sale' or contract_type != 'sale'
                </attribute>

            </xpath> -->
        </field>
    </record>
</odoo>
