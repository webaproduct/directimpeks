<odoo>

    <record id="product_normal_form_view_inherit2" model="ir.ui.view">
        <field name="name">product.normal.form.view.inherit2</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='product_template']" position="after">
                <group string="Product variant" name="product_variant">
                    <field name="size_original_manufacturer"/>
                    <field name="color_manufacturer"/>
                    <field name="palette_colors"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='product_template_variant_value_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="after">
                <field name="product_template_attribute_value_ids" widget="many2many_tags" readonly="1" options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view2" model="ir.ui.view">
        <field name="name">product.product.tree.view2</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="after">
                <field name="product_template_attribute_value_ids" widget="many2many_tags" optional="show" options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view_inherit" model="ir.ui.view">
        <field name="name">product.kanban.view.inherit</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_tags_section')]" position="replace">
                <div class="o_kanban_tags_section">
                    <field name="product_template_attribute_value_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_search_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.search</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gender']" position="after">
                <field name="size_original_manufacturer"/>
                <field name="color_manufacturer"/>
                <field name="palette_colors"/>
            </xpath>

            <xpath expr="//filter[@name='gender']" position="after">
                <filter name="size_original_manufacturer" context="{'group_by':'size_original_manufacturer'}"/>
                <filter name="color_manufacturer" context="{'group_by':'color_manufacturer'}"/>
                <filter name="palette_colors" context="{'group_by':'palette_colors'}"/>
            </xpath>
        </field>
    </record>

</odoo>
