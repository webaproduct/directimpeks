<odoo>

    <menuitem
        id="menu_sale_аdditional_groups"
        name="Additional groups"
        parent="sale.menu_sale_config"
        sequence="80"
    />

    <record id="product_brand_tree" model="ir.ui.view">
        <field name="name">product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree string="Product brand" editable="top" multi_edit="1">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product brand</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_product_brand"
        name="Product brand"
        action="action_product_brand"
        parent="menu_sale_аdditional_groups"
        sequence="1"
    />

</odoo>
