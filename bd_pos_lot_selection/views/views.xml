<?xml version="1.0" encoding="UTF-8" ?>
<!--Two add new field payment_reference and other_details to pos order-->
<odoo>
    <record id="view_pos_config_inherit_form" model="ir.ui.view">
        <field name="name">pos.payment.pos.config.type</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <div class="row mt16 o_settings_container">
                    <setting
                            title="User can not access the create Lot/Serial Number(s)"
                            string="Lot/Serial Number(s) Restrict On POS"
                            help="Allow to user not create new Lot/Serial Number(s)">
                        <field name="lot_serial_no_restrict" readonly="has_active_session"/>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>